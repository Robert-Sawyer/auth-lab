{
  "name": "@auth-lab/database",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "pnpm run generate && tsc --project tsconfig.build.json",
    "generate": "prisma generate",
    "migrate:deploy": "prisma migrate deploy",
    "validate": "prisma validate",
    "typecheck": "pnpm run generate && tsc --noEmit --project tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.9.1",
    "@prisma/client": "7.9.1",
    "dotenv": "17.4.2",
    "pg": "8.23.0"
  },
  "devDependencies": {
    "@types/node": "26.2.0",
    "@types/pg": "8.21.0",
    "prisma": "7.9.1",
    "typescript": "7.0.2",
    "vitest": "4.1.10"
  }
}
