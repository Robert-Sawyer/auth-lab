# Local PostgreSQL instance used by docker compose.
POSTGRES_USER=auth_lab
POSTGRES_PASSWORD=auth_lab
POSTGRES_DB=auth_lab
POSTGRES_PORT=5432

# Prisma CLI and the API use this connection string.
DATABASE_URL="postgresql://auth_lab:auth_lab@localhost:5432/auth_lab?schema=public"

# Local application URLs.
API_HOST=127.0.0.1
API_PORT=3001
WEB_ORIGIN=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:3001

# Google OAuth 2.0 web application credentials. Register the callback URL below
# exactly in Google Cloud Console. Never expose the client secret to Next.js.
GOOGLE_CLIENT_ID=replace-with-google-client-id
GOOGLE_CLIENT_SECRET=replace-with-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:3001/auth/google/callback

# Use a random secret of at least 32 bytes to sign short-lived OAuth transaction cookies.
# Example: node -e "console.log(require('node:crypto').randomBytes(48).toString('base64url'))"
OAUTH_TRANSACTION_COOKIE_SECRET=replace-with-a-random-64-character-secret
