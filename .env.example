# Local PostgreSQL instance used by docker compose.
POSTGRES_USER=auth_lab
POSTGRES_PASSWORD=auth_lab
POSTGRES_DB=auth_lab
POSTGRES_PORT=5432

# Prisma CLI and the API will use this connection string in the next stage.
DATABASE_URL="postgresql://auth_lab:auth_lab@localhost:5432/auth_lab?schema=public"

# Local application URLs.
API_HOST=127.0.0.1
API_PORT=3001
WEB_ORIGIN=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:3001
